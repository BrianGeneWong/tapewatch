# Anthropic credentials. Either export ANTHROPIC_API_KEY here,
# or run `ant auth login` and leave this unset - the SDK finds the profile.
ANTHROPIC_API_KEY=

# SEC requires a descriptive User-Agent with contact info on every request.
# They will rate-limit or block you without it. Format: "Name email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com

# Model routing. The primary model sees every event; the escalation model
# runs only when the primary abstains or reports low confidence.
TAPEWATCH_PRIMARY_MODEL=claude-haiku-4-5
TAPEWATCH_ESCALATION_MODEL=claude-opus-5
